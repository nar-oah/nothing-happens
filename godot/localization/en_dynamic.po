# Current generated effect descriptions not already defined in en.po
msgid "草案的%s纯提案目标不得低于%s的年度期望"
msgstr "The draft's pure proposal target for %s must not fall below the annual expectation of %s"

msgid "%s事件提前获知概率%s"
msgstr "%s event advance-intelligence chance %s"

msgid "将影响率低于%s的利益集团并入%s"
msgstr "Merge interest groups with influence below %s into %s"

msgid "%s对%s的额外影响比例%s"
msgstr "%s additional influence over %s %s"

msgid "受%s影响的席位支持度%s"
msgstr "Support of seats influenced by %s %s"

msgid "修改利益集团：%s"
msgstr "Modify interest groups: %s"

msgid "每年可奏请%s次；可处理%s事件"
msgstr "May petition %s times per year; may resolve events for %s"

msgid "受%s影响的%s在草案使%s低于年初值时缺席表决"
msgstr "%s-influenced %s abstain from the vote when the draft pushes %s below its value at the start of the year"

