[gd_resource type="Resource" script_class="TermStartNewspaperFrontDefinition" format=3 uid="uid://d7m4k9r2va0sx"]

[ext_resource type="Script" path="res://definitions/newspaper_fronts/term_start_newspaper_front_definition.gd" id="1_front"]

[resource]
script = ExtResource("1_front")
title = "第%d次驻岁执政"
content = "新一任联合政府开议。各族彼此看了一圈，最终还是把会同的印信交到驻岁案前；不是因为谁真正满意，只是眼下谁也拿不出更能让彼此放心的人选。长寿不能代替政绩，上届遗下的积弊正等着本届收拾，议会也会据此衡量本届执政的能力。若一时不知从何下手，本报评论或能给些启发。"
target_year = 1
target_month = 1
