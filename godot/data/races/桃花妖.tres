[ext_resource type="Script" uid="uid://c6jh5c18ipwnq" path="res://definitions/race_definition.gd" id="2_v6x64"]

[resource]
script = ExtResource("2_v6x64")
display_name = "桃花妖"
description = "桃花妖曾生活在会主动遮蔽道路的桃源里，土地、宗族与生活资料很少需要服从外界的价格和期限。现代市场却把粮食、木材、土地和劳作都变成税课、货价和不断催促的供货单。于是他们相信疲惫并不是因为世界还不够开放，而是因为道路开得太多了——只要把权力重新收回地方，把往来慢下来，生活自然会恢复秩序。"
decrease_tax = true
decrease_price = true
decrease_trade = true
