[ext_resource type="Script" path="res://definitions/race_definition.gd" id="script"]
[ext_resource type="Resource" path="res://data/interest_groups/造身公所.tres" id="fixed_group"]

[resource]
script = ExtResource("script")
display_name = "偃偶"
description = "偃偶既是有姓名、有责任、有选票的公民，又是能够买卖、出租、抵押和出口的商品。它们要求更完整的人格权，却并不打算因此放弃身契，反而认为只有真正拥有自己，才有资格决定怎样出售自己。偃偶争取的因此不是逃离市场，而是取得作为一个完整的人进入市场、甚至把自己卖得更彻底的权利。"
event_description = "偃偶不再以公共指标形成独立的种族年度期望；其议席的普通政治压力来自造身公所。"
fixed_interest_group = ExtResource("fixed_group")
