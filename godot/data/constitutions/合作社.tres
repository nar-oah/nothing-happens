[gd_resource type="Resource" script_class="NankeConstitutionArticleDefinition" format=3]

[ext_resource type="Script" path="res://definitions/nanke_constitution_article_definition.gd" id="1_article_script"]
[ext_resource type="Script" path="res://definitions/policy_definition.gd" id="2_policy_script"]
[ext_resource type="Resource" path="res://data/races/nanke.tres" id="3_race_nanke"]
[ext_resource type="Resource" path="res://data/constitutions/工会.tres" id="4_prereq"]
[ext_resource type="Resource" path="res://data/interest_groups/槐安公所.tres" id="5_group_1"]
[ext_resource type="Script" path="res://definitions/constitution_seat_condition.gd" id="6_seat_condition_script"]
[ext_resource type="Script" path="res://definitions/constitution_influence_rule.gd" id="7_influence_rule_script"]
[ext_resource type="Resource" path="res://data/policies/盈余返工.tres" id="8_policy_1"]
[ext_resource type="Resource" path="res://data/policies/共担订单.tres" id="9_policy_2"]
[ext_resource type="Resource" path="res://data/policies/合作采购.tres" id="10_policy_3"]

[sub_resource type="Resource" id="Resource_seat_condition"]
script = ExtResource("6_seat_condition_script")
interest_group = ExtResource("5_group_1")
required_rate = 0.5

[sub_resource type="Resource" id="Resource_influence_1"]
script = ExtResource("7_influence_rule_script")
race = ExtResource("3_race_nanke")
interest_group = ExtResource("5_group_1")
mode = 0
rate = 0.7

[resource]
script = ExtResource("1_article_script")
display_name = "合作社"
race = ExtResource("3_race_nanke")
prerequisite = ExtResource("4_prereq")
seat_condition = SubResource("Resource_seat_condition")
absence_probability = 0.05
strike_enabled = true
strike_group = ExtResource("5_group_1")
strike_extends_to_group = true
policies = Array[ExtResource("2_policy_script")]([ExtResource("8_policy_1"), ExtResource("9_policy_2"), ExtResource("10_policy_3")])
influence_rules = Array[ExtResource("7_influence_rule_script")]([SubResource("Resource_influence_1")])
