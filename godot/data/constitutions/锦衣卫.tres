[resource]
script = ExtResource("1_article_script")
donation_detection_probability = 0.0
event_early_reveal_bonus_probability = 0.25
display_name = "锦衣卫"
description = "若问题在于政府知道得太晚，那么最直接的答案，就是派更多人去更早地知道一切。
锦衣卫绕过公开监督，把耳目伸进尚未成为新闻的地方。它确实能更早发现正在形成的问题，可当整个社会知道有人正在寻找危机时，每一个风声也会显得更像危机。
蓬莱获得了一双更敏锐的眼睛，也顺便学会了更加紧张地看待自己。"
row = ExtResource("row")
race = ExtResource("3_race_zhushui")
participates_in_variable_seat_allocation = false
expectation_growth_rate = -1.0
policies = Array[ExtResource("2_policy_script")]([ExtResource("4_policy_1"), ExtResource("5_policy_2"), ExtResource("6_policy_3")])
