[resource]
script = ExtResource("article_script_1")
display_name = "锦衣卫"
description = "若问题在于政府知道得太晚，那么最直接的答案，就是派更多人去更早地知道一切。
锦衣卫绕过公开监督，把耳目伸进尚未成为新闻的地方。它确实能更早发现正在形成的问题，可当整个社会知道有人正在寻找危机时，每一个风声也会显得更像危机。
蓬莱获得了一双更敏锐的眼睛，也顺便学会了更加紧张地看待自己。"
row = ExtResource("row_7")
policies = Array[ExtResource("policy_type_2")]([ExtResource("policy_8"), ExtResource("policy_9"), ExtResource("policy_10")])
effects = Array[ExtResource("effect_type_3")]([SubResource("Effect_1"), SubResource("Effect_2"), SubResource("Effect_3"), SubResource("Effect_4"), SubResource("Effect_5"), SubResource("Effect_6")])
