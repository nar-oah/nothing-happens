[resource]
script = ExtResource("article_script_1")
display_name = "自由贸易"
description = "大明的旗号可以留在港口，但货物不该因为挂着谁的旗就先过栈桥。
自由贸易取消朝廷在航路、关税和货物上的优先权，把永乐港变成所有商人都按同一套规矩竞争的港口。可当旧有特权真正消失，原本只想做生意的轮运局，也会突然发现自己肩上还有“官督”二字。"
row = ExtResource("row_7")
policies = Array[ExtResource("policy_type_2")]([ExtResource("policy_8"), ExtResource("policy_9"), ExtResource("policy_10")])
effects = Array[ExtResource("effect_type_3")]([SubResource("Effect_1"), SubResource("Effect_2"), SubResource("Effect_3"), SubResource("Effect_4")])
