script = ExtResource("1_qxpgu")
display_name = "桃源"
description = "古老桃林围绕的封闭谷地，也是桃花妖祖地。外界把这里当作未经现代化破坏的田园遗存，当地人则更倾向认为，是外界主动把自己卷进了本来可以避免的麻烦。"
