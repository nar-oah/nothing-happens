[resource]
script = ExtResource("1_qxpgu")
display_name = "久视"
description = "驻岁过去最重要的聚居与跨族议约之地，许多古约、祭仪和长期争端都曾由这里的驻岁见证。如今宽阔的旧宅、礼场和道路大多已经空置，地方本身比仍然活着的驻岁更完整地保存着这个种族曾经存在过的规模。"
anchor_race = ExtResource("1_l0n4x")
fixed_race = ExtResource("1_l0n4x")
