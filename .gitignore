# ============================================================
# Godot
# ============================================================

# Godot 4 generated/import cache
godot/.godot/

# Mono / C# generated files, harmless even if not currently used
godot/.mono/

# Editor-specific generated files
godot/*.tmp

# Godot CEF contains ~2.4 GB of platform binaries.
godot/addons/godot_cef/


# ============================================================
# Svelte build copied into Godot
# ============================================================

# Generated by `pnpm build`, should not be committed.
# GitHub Actions / local build should regenerate it before Godot export.
godot/web/


